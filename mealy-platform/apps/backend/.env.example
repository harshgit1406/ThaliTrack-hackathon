NODE_ENV=development
MEALY_API_HOST=0.0.0.0
MEALY_API_PORT=8080
MEALY_REALTIME_HOST=0.0.0.0
MEALY_REALTIME_PORT=8081
MEALY_DATABASE_URL=postgresql://mealy:replace-with-a-long-random-password@postgres:5432/mealy
MEALY_DATABASE_POOL_MAX=10
# Enable only when the API is reachable exclusively through a trusted reverse proxy.
MEALY_TRUST_PROXY=false
MEALY_BODY_LIMIT_BYTES=1048576
MEALY_RATE_LIMIT_MAX=300
MEALY_AUTH_RATE_LIMIT_MAX=10
MEALY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177
MEALY_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-bootstrap-token
# Keep false except during a controlled initial administrator provisioning window.
MEALY_BOOTSTRAP_ADMIN_ENABLED=false
# Enables seeded demo identities and mock UPI only for the hackathon environment.
MEALY_DEMO_MODE=false
MEALY_SESSION_TTL_HOURS=24
# `console` logs OTPs only in local development. Production must use an SMS adapter when one is selected.
MEALY_OTP_PROVIDER=console
MEALY_WORKER_INTERVAL_MS=1000
MEALY_REALTIME_POLL_MS=500
MEALY_GATEWAY_HEARTBEAT_MS=15000
MEALY_GATEWAY_STALE_MS=45000
MEALY_REALTIME_MAX_CONNECTIONS=500
MEALY_REALTIME_MAX_PAYLOAD_BYTES=65536
