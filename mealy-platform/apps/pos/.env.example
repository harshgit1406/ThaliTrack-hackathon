# Public Mealy API origin. Do not place database or bootstrap secrets here.
VITE_MEALY_API_BASE_URL=http://localhost:8080
# Optional external media origin. Leave blank when POS serves its bundled /food assets.
VITE_MEALY_MEDIA_BASE_URL=
VITE_MEALY_OUTLET_ID=replace-with-outlet-uuid
VITE_MEALY_COUNTER_ID=replace-with-counter-uuid
VITE_MEALY_TERMINAL_ID=replace-with-terminal-uuid
VITE_MEALY_GATEWAY_URL=http://127.0.0.1:8788
VITE_MEALY_GATEWAY_TOKEN=replace-with-the-same-lan-token-as-the-gateway
