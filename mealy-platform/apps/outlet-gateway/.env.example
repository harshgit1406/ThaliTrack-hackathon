MEALY_GATEWAY_ID=gateway-central-canteen-01
MEALY_OUTLET_ID=outlet-central-canteen
MEALY_OUTLET_NAME=Central Canteen
MEALY_STATION_ID=station-main-kitchen
MEALY_STATION_NAME=Main Kitchen
MEALY_COUNTER_ID=replace-with-counter-uuid
MEALY_TERMINAL_ID=replace-with-terminal-uuid
MEALY_GATEWAY_HOST=0.0.0.0
MEALY_GATEWAY_PORT=8788
